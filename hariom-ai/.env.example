# Hariom AI - Environment Variables
# -----------------------------------------
# 1. Copy this file to a new file named ".env" (in the same folder).
# 2. Paste your Google Gemini API key below (without quotes).
# 3. Get a free key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_api_key_here

# Vercel deployment settings (configure these as Vercel environment variables)
# DATABASE_URL=your_neon_postgresql_connection_string
# SITE_PASSWORD=choose_a_long_private_password
